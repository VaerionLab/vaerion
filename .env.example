# VAERION — credential names of record (Phase 12 §6 · docs/operations/LAUNCH-SEQUENCE.md Phase B)
#
# LAW: names only. No value in this file is ever real. Copy to .env.local
# (gitignored by `.env*`) or provision as CI secrets. Values never enter
# code, the tracked tree, or a command line.
# Presence gate (existence only): bun run launch:credential-check --strict

# — GitHub operations: tags, releases, remote protection (local-or-ci) —
# Developer account of record (vaeriondev)
GITHUB_TOKEN=

# — GitHub operations: organization-side account (falconxa0-commits) —
FALCONXA0_GITHUB_TOKEN=

# — npm publish: vaerion CLI (packaging/npm/) (CI secret) —
NPM_TOKEN=

# — PyPI publish: vaerion wheel (packaging/python/) (CI secret) —
PYPI_API_TOKEN=
TWINE_USERNAME=__token__

# — VS Code Marketplace publish (editors/vscode/) (local-or-ci) —
VSCE_PAT=

# — Website deployment (vaerion.dev; F-5 unprovisioned) (local-or-ci) —
DEPLOY_TOKEN=

# — Release signing, Ed25519 private half (CI secret, never local) —
RELEASE_SIGNING_KEY=
