<idea-plugin>
  <!-- Vaerion for JetBrains IDEs — minimal skeleton.
       HONESTY MARKER: this plugin has NEVER been compiled or executed (no
       IntelliJ SDK / Gradle toolchain exists in the Vaerion build
       environment). It is a credible starting point, not a verified
       integration. The CLI contracts it calls ARE verified (editor
       protocol v1) by the repository's own test suite. -->
  <id>dev.vaerion.editors.jetbrains</id>
  <name>Vaerion</name>
  <vendor>auren</vendor>
  <description><![CDATA[
    The Vaerion Developer Workspace Experience: project status, one-click
    doctor, insight report, run history and journals — all through the
    local <code>vae</code> CLI. The CLI owns all business logic; this
    plugin is a window.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <actions>
    <action id="Vaerion.Status" class="dev.vaerion.editors.jetbrains.VaerionStatusAction"
            text="Vaerion Status" description="vae status --json into a dialog">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
