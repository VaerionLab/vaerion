    "vaerion:verify-state": "bun tools/vaerion-pipeline/verify-state.ts",
    "vaerion:verify-interaction": "bun tools/vaerion-pipeline/verify-interaction.ts",
    "vaerion:verify-rendering": "bun tools/vaerion-pipeline/verify-rendering.ts",
    "vaerion:verify-authorities": "bun tools/vaerion-pipeline/verify-authorities.ts",
    "vaerion:verify-snapshots": "bun tools/vaerion-pipeline/verify-snapshots.ts",
    "vaerion:verify-parity": "bun tools/vaerion-pipeline/verify-parity.ts",
    "vaerion:verify-accessibility": "bun tools/vaerion-pipeline/verify-accessibility.ts",
