    "vaerion:verify-security": "bun tools/vaerion-pipeline/verify-security.ts",
    "vaerion:test-all": "bun tools/vaerion-pipeline/verify-all.ts",
    "vaerion:verify-build": "bun tools/vaerion-pipeline/verify-build.ts",
    "vaerion:verify-signatures": "bun tools/vaerion-pipeline/verify-signatures.ts",
    "vaerion:verify-artifacts": "bun tools/vaerion-pipeline/verify-artifacts.ts",
    "vaerion:verify-distribution": "bun tools/vaerion-pipeline/verify-distribution.ts",
    "vaerion:verify-rollback": "bun tools/vaerion-pipeline/verify-rollback.ts",
    "vaerion:verify-release": "bun tools/vaerion-pipeline/verify-release.ts",
    "vaerion:verify-trust": "bun tools/vaerion-pipeline/verify-trust.ts",
    "vaerion:verify-everything": "bun tools/vaerion-pipeline/verify-everything.ts",
